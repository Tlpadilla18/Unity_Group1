# Copy this file to ".env" and fill in your own values. Never commit .env.

# MongoDB Atlas connection string (Database > Connect > Drivers)
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=shapegame

# Two different random strings. Generate each with:   npm run secret
# MONGODB_SESSION_SECRET MUST have 2+ uppercase, 2+ lowercase, 2+ numbers and 2+ symbols.
NODE_SESSION_SECRET=paste-output-of-npm-run-secret
MONGODB_SESSION_SECRET=paste-a-different-output-of-npm-run-secret

# Where the game is hosted (comma-separated), e.g. https://yourname.github.io
ALLOWED_ORIGINS=

# "production" on Render/Qoddi, "development" on your computer.
NODE_ENV=development
PORT=3000
